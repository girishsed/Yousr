# Yousr settings. Open this file in TextEdit (Mac) or Notepad (Windows), fill in, save, then start again.
# Keep this file private: it holds your Resend key. Never share it or paste it in a chat.

# Your Resend API key (resend.com > API Keys). Leave empty to show codes on screen instead of emailing them.
RESEND_API_KEY=

# The sender. Its domain must be verified in Resend (resend.com > Domains), for example compane.ai
RESEND_FROM=Yousr <no-reply@compane.ai>

# false hides "Sample people" on the sign-in page (keep false for outside testers; true for your own trials)
SAMPLE_PEOPLE=true

